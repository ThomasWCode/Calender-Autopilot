<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or moved to a new phone: alarms belong to this phone's scans. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </device-transfer>
</data-extraction-rules>
